模型2.5版本，业界首个一站式3D内容AI创作平台。腾讯混元3D创作平台是一站式3D内容AI创作平台。具备文生、图生3D、3D动画生成、纹理生成等功能，支持草图生3D、3D人物生成，有低多边形模型生成优势。\"\nindex\t\"在这里，探索更多好玩的3D应用\"\nindex\t\"提供不同的3D生成能力，更多好玩的应用持续扩充，敬请期待\"\nindex\t\"拓扑选择\"\nindex\t\"三四边面混合，适合简单结构\"\nindex\t\"最大化模型细节，适用于游戏引擎\"\nindex\t\"提供更好的平滑度和规则结构，适合模型编辑\"\nindex\t\"根据物体复杂程度，自适应生成几百至数千面的模型，可选择三角面或四边面，拓扑布线更加符合美术标准，建议输入简单物体，复杂物体不支持低多边形生成，预计生成时间较久，请耐心等待\"\nindex\t\"上传模型要求\"\nindex\t\"上传模型拓扑后都会生成白模，请上传白模\"\nindex\t\"上传模型尽量简单，过于复杂模型无法拓扑\"\nindex\t\"输入<b>文本</b>、<b>图片</b>或<b>白模</b>，生成布线规整的低面数模型\"\nindex\t\"看看以下作品\"\nindex\t\"添加草图\"\nindex\t\"背景纯色\"\nindex\t\"线条简洁\"\nindex\t\"输入文字描述\"\nindex\t\"请结合草图描述想要生成的3D模型。提示词要求：1.建议描述物体的类别+颜色等内容；2.尽量描述与图片一致的内容。\"\nindex\t\"上传<b>草图</b>，输入<b>指令</b>，一键生成3D模型\"\nindex\t\"试试以下灵感\"\nindex\t\"WebGL 未启用或不受支持，请参考下方教程激活或升级到最新版本的 Chrome、Firefox 或 Edge 浏览器\"\nindex\t\"您的浏览器仅支持 WebGL 1.0 ({{version}})，建议升级到最新版本的 Chrome、Firefox 或 Edge 浏览器\"\nindex\t\"您的浏览器已启用 WebGL 2.0 ({{version}})\"\nindex\t\"WebGL 检测/激活\"\nindex\t\"如果当前页面上出现绿色消息，则表示 <Text>WebGL2.0</Text> 已激活，可以正常查看模型。但是，如果显示红色或黄色告警消息，表示你的 <Text>WebGL</Text> 可能存在问题，请尝试按照以下教程之一来解决此问题。\"\nindex\t\"Chrome (Android/PC) 启用 WebGL2 教程\"\nindex\t\"在某些 Chrome 版本上，默认情况下可能不会激活 WebGL。激活它您才有查看模型的能力。要验证是否可以激活 WebGL，请按照以下步骤操作（Google Chrome 教程）：\"\nindex\t\"单击以下链接：\"\nindex\t\"搜索 <Text>WebGL</Text>并启用它\"\nindex\t\"重新加载浏览器\"\nindex\t\"返回当前页面刷新并检查现在是否支持 \"\nindex\t\"iPhone/iPad 激活 WebGL2 教程\"\nindex\t\"本教程仅在您使用 IOS 15.0 或更高版本时有用，使用 IOS 14.x 或更低版本的设备即使激活了WebGL，可能也无法使用。另请注意，只有 Safari 需要激活 WebGL，其他浏览器默认启用\"\nindex\t\"首先，转到手机 <Text>设置</Text>, 搜索 <Text>Safari</Text> 并选择它\"\nindex\t\"向下滚动到 <Text>高级</Text>, 点击进入\"\nindex\t\"选择最后一个选项 <Text>实验功能</Text>，点击进入\"\nindex\t\"查找 <Text>WebGL 2.0</Text>, 并打开开关\"\nindex\t\"Mac Safari 激活 WebGL2 教程\"\nindex\t\"本教程仅在您使用 Safari 15.0 或更高版本时有用，使用 Safari 14.x 或更低版本的 Mac 即使激活了 WebGL，可能也无法查看模型。另请注意，只有 Safari 需要激活 WebGL，其他浏览器默认使用它\"\nindex\t\"首先，您必须打开 <Text>Safari &gt; 偏好设置</Text>。\"\nindex\t\"选择 <Text>高级</Text> 标签，在当前标签栏的最底部，勾选 <Text>在栏中显示开发菜单</Text>\"\nindex\t\"在 Safari 浏览器的顶部栏中找到 <Text>开发人员菜单</Text>，打开它并转到 <Text>实验功能</Text>, 并勾选 <Text>WebGL 2.0</Text>\"\nindex\t\"以上教程仍无法解决问题？\"\nindex\t\"如果以上教程仍无法解决问题，请尝试升级到最新版本的 Chrome、Firefox 或 Edge 浏览器。\"\nindex\t\"分享内容已过期\"\nindex\t\"欢迎来到\"\nindex\t\"登录后开启3D创作之旅\"\nindex\t\"开启全新3D视界\"\nindex\t\"申请体验\"\nindex\t\"申请成功，请耐心等待\"\nindex\t\"申请失败，请下次再试\"\nindex\t\"查看更多3D模型\"\nindex\t\"举报\"\nindex\t\"原始UV\"\nindex\t\"模型\"\nindex\t\"设计理念\"\nindex\t\"站立\"\nindex\t\"几何风格\"\nindex\t\"创建模型\"\nindex\t\"更多信息\"\nindex\t\"生成信息\"\nindex\t\"提示\"\nindex\t\"当前正在获取下载链接，切换模型或离开当前页面将取消下载。\"\nindex\t\"暂不支持下载{{fileFormat}}格式\"\nindex\t\"移动端仅支持模型查看，更多功能欢迎在电脑端访问\"\nindex\t\"中文\"\nindex\t\"brand.keyword\"\nindex\t\"brand.description\"\nindex\t\"Failed to change language:\"\nindex\t\"hunyuan-base-test-1258344703.cos.ap-guangzhou.myqcloud.com\"\nindex\t\"hunyuan-base-test-1258344703.cos.accelerate.myqcloud.com\"\nindex\t\"hunyuan-base-prod-1258344703.cos.ap-guangzhou.myqcloud.com\"\nindex\t\"hunyuan-base-prod-1258344703.cos.accelerate.myqcloud.com\"\nindex\t\"accelerate.myqcloud.com\"\nindex\t\")[0];if(l.has(o))return l.get(o);const n=(e=>{const t=new URL(e),{pathname:o}=t,n=(0,a.mI)(),r=(0,a.n3)(),l=`${o}-${n}-${r}-0-9FTsL0eAI13Z22R6Lg90EIUD4UtzOD`;return`${n}-${r}-0-${i()(l).toString()}`})(t),r=`${o}?sign=${n}`;return l.set(o,r),r}},33620:(e,t,o)=>{\"\nindex\t\"3d.global.pre.hunyuan.woa.com\"\nindex\t\"hy3d.tencent.ai\"\nindex\t\"3d.hunyuanglobal.com\"\nindex\t\"3d.tencent.ai\"\nindex\t\")}(h),y=(w=f,v=function(e){if(16!==e.length)throw new Error(\"\nindex\t\");const t=new Uint8Array(16);for(let o=0;o<16;o++)t[o]=e[o]^d[o];const o=new Uint8Array(16);for(let e=0;e<16;e++){const n=u[e];o[e]=255&(t[e]<<n|t[e]>>>8-n)}const n=new Uint8Array(16);for(let e=0;e<16;e++)n[e]=o[m[e]];let a=n.indexOf(0);return-1===a&&(a=16),(new TextDecoder).decode(n.slice(0,a))}(c),i()(w,v).toString(a()));var w,v;return g[p]=y,g}},49102:(e,t,o)=>{\"\nindex\t\";o.d(t,{A:()=>b});var n,a=o(96540);function r(){return r=Object.assign?Object.assign.bind(