u = #EBA586 skin_1
v = #D07C74 skin_0
L = #B0606A line_skin
i = #153E4E iris_0
j = #2C9696 iris_1
k = #86DCC6 iris_2
W = #FFFFFF snow_3
n = #DFEAF6 snow_2
b = #1C4C54 teal_0
c = #2A8C8E teal_1
e = #6ACBB6 teal_2
r = #8E2C4A crn_1
z = #BA4A58 crn_2
x = #F06A58 red_2
w = #A8C0E0 snow_1 tear/sweat
R = #DC3A40 red_1 FX
