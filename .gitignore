# review-hub experiment intermediates (kept on disk only; boards, gifs, notes, scripts, entries are committed)
REVIEW/exp/*/big/
REVIEW/exp/*/frames/
REVIEW/exp/*/tmp/
REVIEW/exp/*/work/
REVIEW/exp/*/out/
# per-frame render passes: keep only the GIFs and sheets
REVIEW/exp/*/render/out/*/*
!REVIEW/exp/*/render/out/*/*.gif
!REVIEW/exp/*/render/out/*/*_sheet.png
REVIEW/exp/*/motion/prev/
# Blender backups and per-frame dumps under experiments (keep GIFs, sheets/boards, notes, scripts)
*.blend1
REVIEW/exp/*/rig/work/
REVIEW/exp/*/rig/qa/*/
REVIEW/exp/*/face/out/*/*
!REVIEW/exp/*/face/out/*/*.gif
!REVIEW/exp/*/face/out/*/*sheet*.png
!REVIEW/exp/*/face/out/*/*board*.png
REVIEW/exp/*/face/out/p2cur/
# any nested work/ dumps inside experiments (e.g. release/out/<build>/work/)
REVIEW/exp/**/work/
REVIEW/exp/*/face/f3d/out/
REVIEW/exp/*/face/illus/out/
REVIEW/exp/*/face/illus/out_r7/
REVIEW/exp/*/pipe/tmp/
# charlab intermediates
charlab/**/work/
charlab/**/tmp/
